{
  "manifest_version": 3,
  "name": "倒计时",
  "version": "2.0.0",
  "description": "摸鱼人的倒计时与节假日拼假插件",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png"
    },
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://fastly.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://raw.githubusercontent.com https://cdn.jsdelivr.net https://fastly.jsdelivr.net"
  }
}